# Vill Shop — Environment Variables

# Docker Compose (local development)
POSTGRES_DB=vill_shop
POSTGRES_USER=vill_shop
POSTGRES_PASSWORD=secret

# Backend (see backend/.env.example for full list)
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vill_shop
DB_USERNAME=vill_shop
DB_PASSWORD=secret
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=change-me-in-production
RESEND_KEY=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/convert
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET=vill-shop
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
SENTRY_LARAVEL_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# AWS Production (CI/CD secrets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
ECR_BACKEND_REPO=vill-shop-backend
ECR_FRONTEND_REPO=vill-shop-frontend
