# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=villshop
DB_PASSWORD=password
DB_DATABASE=villshop

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-32-chars-minimum

# ─── SMTP (Nodemailer) ────────────────────────────────────────────────────────
# Local: Mailpit (http://localhost:8025)
# Production options: Brevo (300/day free), Gmail SMTP, Resend SMTP bridge
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vill Shop <noreply@villshop.com>"

# ─── S3 / MinIO ───────────────────────────────────────────────────────────────
# Local: MinIO at http://localhost:9000 (console: http://localhost:9001)
# Production: AWS S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=villshop

# ─── Pesapal ──────────────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox

# ─── Exchange Rates ───────────────────────────────────────────────────────────
# Free API: https://exchangerate.host (no credit card required)
EXCHANGE_RATE_API_KEY=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@villshop.local
PORT=8081
