# App
NODE_ENV=development
PORT=8081

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=villshop
DB_PASSWORD=password
DB_DATABASE=villshop
DB_SSL=false
DB_SYNC=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production-use-32-chars-min

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Vill Shop
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
# Log emails to console instead of sending (set false in production)
EMAIL_DRY_RUN=true

# Legacy aliases (optional)
SMTP_PASS=
SMTP_FROM=

# S3/MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=villshop

# Pesapal — leave keys empty to auto-simulate payments locally
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=
PESAPAL_SIMULATE=false
BACKEND_URL=http://localhost:8081

# Exchange Rates
EXCHANGE_RATE_API_KEY=

# Sentry
SENTRY_DSN=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin — created or promoted on backend startup (required)
ADMIN_EMAIL=arnoldchrisoduor@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
