# App
NODE_ENV=development
PORT=8081

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=villshop
DB_PASSWORD=password
DB_DATABASE=villshop
DB_SSL=false
DB_SYNC=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production-use-32-chars-min

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Vill Shop
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
# Log emails to console instead of sending (set false in production)
EMAIL_DRY_RUN=true

# Legacy aliases (optional)
SMTP_PASS=
SMTP_FROM=

# S3/MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=villshop

# Pesapal
# Put your real consumer key/secret here. With keys present, real Pesapal is used.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# 'production' = https://pay.pesapal.com/v3 | 'sandbox' = https://cybqa.pesapal.com/pesapalv3
PESAPAL_ENV=production
# Optional: pre-registered IPN id. Leave blank to auto-register the IPN URL on first payment.
PESAPAL_IPN_ID=
# Username required for refund requests (optional)
PESAPAL_USERNAME=
# Set to 'true' only to force fake/simulated payments in local dev
PESAPAL_SIMULATE=false

# Public base URL Pesapal can reach (no trailing slash). nginx must proxy /api/
# to this backend. IPN = {PUBLIC_URL}/api/pesapal/ipn, callback = {PUBLIC_URL}/api/pesapal/callback
PUBLIC_URL=https://shop.villa-allegra.com
BACKEND_URL=http://localhost:8081

# Exchange Rates
EXCHANGE_RATE_API_KEY=

# Sentry
SENTRY_DSN=

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin — created or promoted on backend startup (required)
ADMIN_EMAIL=arnoldchrisoduor@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
